(version 1)
(deny default)
;; Smallest system allows measured for harflow-ctl: it execs, reads "/" and queries sysctl.
;; /bin/ps is setuid root, so the caller process view runs outside the sandbox.
(allow process-exec* (literal "@BINARY@"))
(allow process-exec* (literal "/bin/ps") (with no-sandbox))
(allow process-fork)
(allow file-read-metadata)
(allow file-read* (literal "/"))
(allow file-read* (literal "/dev/null"))
(allow file-write-data (literal "/dev/null"))
(allow sysctl-read)
;; Authorised and ancestry-refused reads: the exact file set of the store session.
(allow file-read* (literal "@ROOT@"))
(allow file-read* (literal "@ROOT@/store.identity"))
(allow file-read* (literal "@ROOT@/store.lock"))
(allow file-read* (literal "@ROOT@/store.sqlite3"))
(allow file-read* (literal "@ROOT@/store.sqlite3-wal"))
(allow file-read* (literal "@ROOT@/store.sqlite3-shm"))
(allow file-read* (literal "@ROOT@/store.watermark"))
(allow file-write-data (literal "@ROOT@/store.lock"))
